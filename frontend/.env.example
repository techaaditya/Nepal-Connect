# Copy this file to frontend/.env and fill in values. Do NOT commit your real .env.

# Base URL for the backend API (React dev server proxies /api to http://localhost:5000)
REACT_APP_API_BASE_URL=/api

# Optional (local dev only): Gemini API key for testing direct calls from the browser.
# Leave unset in production; prefer the backend /api/chat endpoint.
# REACT_APP_GEMINI_API_KEY=

# Google Maps JS API key (frontend). If you use this, RESTRICT it to your site via HTTP referrer restrictions in Google Cloud.
# If not set, the app will fall back to the Leaflet/OpenStreetMap preview.
# REACT_APP_GOOGLE_MAPS_API_KEY=

# Firebase Web config (identifiers, not secrets) – required for Auth
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=
